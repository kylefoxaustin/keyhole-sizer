peak_bw_gbps          = 134.4
bw_share_frac         = 0.75
bw_efficiency_frac    = 0.70
notes                 = ""

# NPU High FP — same silicon, FP path (200 eTOPS, half of INT8 compute).

[npu_llm_anchors.high_fp.qwen3_30b_a3b_moe]
